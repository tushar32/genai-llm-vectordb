{
  "name": "rag-api-nodejs",
  "version": "1.0.0",
  "description": "Node.js RAG API with pgVector and streaming responses",
  "main": "src/handler.js",
  "scripts": {
    "build": "tsc",
    "start": "serverless offline",
    "dev": "serverless offline --stage dev",
    "lambda:local": "npm run build && node dist/lambda-server.js",
    "sam:build": "sam build",
    "sam:local": "sam local start-api --port 3000",
    "sam:dev": "npm run build && npm run sam:build && npm run sam:local",
    "docker:build": "docker build -t rag-api .",
    "docker:run": "docker run -p 8080:8080 --env-file .env rag-api",
    "docker:dev": "docker build --target development -t rag-api:dev . && docker run -p 8080:8080 --env-file .env rag-api:dev",
    "db:up": "docker-compose up postgres -d",
    "db:down": "docker-compose down",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migrate:make": "knex migrate:make",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed:make": "knex seed:make",
    "seed:run": "knex seed:run",
    "deploy:staging": "npm run build && serverless deploy --stage staging",
    "deploy:production": "npm run build && serverless deploy --stage production"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.450.0",
    "@aws-sdk/client-lambda": "^3.450.0",
    "@aws-sdk/client-secrets-manager": "^3.450.0",
    "@aws-sdk/rds-signer": "^3.556.0",
    "aws-lambda": "^1.0.7",
    "dotenv": "^16.3.1",
    "knex": "^3.1.0",
    "openai": "^4.20.1",
    "pg": "^8.12.0",
    "pgvector": "^0.1.8",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.7",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0",
    "serverless-plugin-include-dependencies": "^6.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "rag",
    "vector-database",
    "pgvector",
    "nodejs",
    "aws-lambda",
    "streaming"
  ],
  "author": "",
  "license": "MIT"
}
