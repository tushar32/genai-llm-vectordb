{
  "name": "rag-api-nodejs",
  "version": "1.0.0",
  "description": "Node.js RAG API with pgVector and streaming responses",
  "main": "src/handler.js",
  "scripts": {
    "build": "tsc",
    "start": "serverless offline",
    "dev": "serverless offline --stage dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:smoke": "jest --testPathPattern=smoke",
    "test:health": "curl -f http://localhost:3000/health || exit 1",
    "db:up": "docker-compose up postgres -d",
    "db:down": "docker-compose down",
    "docs:generate": "typedoc src --out docs",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "migrate:make": "knex migrate:make",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed:make": "knex seed:make",
    "seed:run": "knex seed:run",
    "deploy:staging": "npm run build && serverless deploy --stage staging",
    "deploy:production": "npm run build && serverless deploy --stage production"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.450.0",
    "@aws-sdk/client-lambda": "^3.450.0",
    "@aws-sdk/rds-signer": "^3.556.0",
    "aws-lambda": "^1.0.7",
    "knex": "^3.1.0",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "pgvector": "^0.1.8",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.7",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "axios": "^1.6.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typedoc": "^0.25.4",
    "typescript": "^5.2.2"
  },
  "keywords": [
    "rag",
    "vector-database",
    "pgvector",
    "nodejs",
    "aws-lambda",
    "streaming"
  ],
  "author": "",
  "license": "MIT"
}
